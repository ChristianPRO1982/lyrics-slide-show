COMPOSE_PROJECT_NAME=lss
DJANGO_DEBUG=false
SHARED_SECRETS_DIR=/opt/stacks/_shared/secrets
TRAEFIK_PROXY_NETWORK=proxy
LSS_DOMAIN=lss.animation-messe.fr
DJANGO_SECRET_KEY_FILE=/opt/stacks/_shared/secrets/lss/django_secret_key.txt
DJANGO_ALLOWED_HOSTS=lss.animation-messe.fr
DJANGO_CSRF_TRUSTED_ORIGINS=https://lss.animation-messe.fr
DJANGO_TIME_ZONE=Europe/Paris
DJANGO_USE_X_FORWARDED_HOST=true
DJANGO_USE_X_FORWARDED_PORT=true
DJANGO_SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_SESSION_COOKIE_SAMESITE=Lax
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SAMESITE=Lax
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_SECURE_REFERRER_POLICY=same-origin
DJANGO_SECURE_CONTENT_TYPE_NOSNIFF=true
DJANGO_AUTH_LOG_LEVEL=INFO
DB_HOST=postgres
DB_PORT=5432
DB_NAME=carthographie
DB_USER=app_lss
DB_PASSWORD_FILE=/opt/stacks/_shared/secrets/pg-carthographie/app_lss/lss_password.txt
DB_CONN_MAX_AGE=60
AUTH_MODE=keycloak
USER_SCHEMA=users
USER_TABLE=users
KEYCLOAK_SERVER_URL=https://auth.example.com
KEYCLOAK_REALM=carthographie
KEYCLOAK_CLIENT_ID=app_lss
KEYCLOAK_CLIENT_SECRET_FILE=/opt/stacks/_shared/secrets/lss/client_secret.txt
KEYCLOAK_REDIRECT_URI=https://lss.animation-messe.fr/auth/callback/
KEYCLOAK_LOGOUT_REDIRECT_URI=https://lss.animation-messe.fr/
KEYCLOAK_SCOPES=openid profile email
SHARED_DB_NETWORK=backend
LSS_BIND_PORT=8000
