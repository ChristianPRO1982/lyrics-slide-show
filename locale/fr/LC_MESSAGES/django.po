#: app_main/templates/main/privacy_policy.html:175
msgid "❌ <b>Aucun e-mail n’est envoyé pour :</b>"
msgstr ""

#: app_main/templates/main/privacy_policy.html:177
msgid "Annoncer de nouvelles fonctionnalités"
msgstr ""

#: app_main/templates/main/privacy_policy.html:178
msgid "Proposer des publicités"
msgstr ""

#: app_main/templates/main/privacy_policy.html:179
msgid "Envoyer des newsletters, invitations, ou communications commerciales"
msgstr ""

#: app_main/templates/main/privacy_policy.html:181
msgid ""
"Vous ne recevrez donc aucun e-mail inutile ou non sollicité, conformément à "
